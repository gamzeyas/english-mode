# English Mode — environment variables (names only; never commit real values).
# Locally: `vercel env pull` writes .env.local from the linked Vercel project.

# Supabase (provisioned via the Vercel Marketplace integration).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — bypasses RLS. Used by scripts/tests, never in client code.
SUPABASE_SECRET_KEY=
# Direct Postgres connection used by `pnpm db:push` / `pnpm db:types`.
POSTGRES_URL_NON_POOLING=

# Comma-separated emails allowed to sign in (personal-use gate; empty = nobody).
ALLOWED_EMAILS=

# Claude API (server only). Coach + analyzer default to claude-opus-5-5.
ANTHROPIC_API_KEY=
# Optional overrides, e.g. claude-sonnet-5-5 for a cheaper coach.
AI_CHAT_MODEL=
AI_ANALYSIS_MODEL=


# Azure Speech pronunciation assessment (Milestone 7). Server only.
# Azure AI Speech (Milestone 6+): fast transcription; pronunciation in Milestone 7.
# Region of the Speech resource, e.g. westeurope.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: https://<resource>.cognitiveservices.azure.com (defaults to the regional endpoint)
AZURE_SPEECH_ENDPOINT=
